// Pacote compartilhado. O front e a API leem os tipos direto de src/index.ts
// (campo "types" do package.json, T-017), então NÃO precisam da dist/ para compilar.
// O `npm run build` ainda gera a dist/: confere os tipos do pacote e entrega o
// JavaScript apontado em "default", que hoje fica vazio (o pacote só exporta tipos).
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Módulos ES com as regras de resolução do Node (exigem a extensão .js nos imports).
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Gera também os .d.ts na dist/, para quem um dia consumir o pacote já compilado
    // (o front e a API, dentro do monorepo, leem o src/ direto).
    "declaration": true,

    "rootDir": "src",
    "outDir": "dist",

    // O pacote não depende de nenhum ambiente (nem Node, nem navegador).
    "types": []
  },
  "include": ["src"]
}
