# Variáveis de ambiente da API (apps/api).
#
# Como usar em desenvolvimento: copie este arquivo para apps/api/.env e preencha.
# A API roda com a pasta apps/api como diretório atual, por isso o .env fica lá.
# O .env é ignorado pelo git (ver .gitignore): segredos nunca vão para o repositório.
# Em produção (Render), as mesmas variáveis são cadastradas no painel do serviço.

# Porta em que a API escuta.
PORT=3000

# Origem (endereço) do front que pode chamar a API — CORS, RNF-05.
# Em desenvolvimento é o endereço do Vite; em produção, o do Cloudflare Pages.
CORS_ORIGIN=http://localhost:5173

# Token de acesso à API do GitHub (dados vivos dos projetos, T-011).
# Opcional em desenvolvimento: sem ele a API do GitHub funciona com limite menor de requisições.
# Nunca coloque um token real neste arquivo.
GITHUB_TOKEN=
